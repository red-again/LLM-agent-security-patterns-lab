+def human_review(ranked: list[str], world: World, top_n: int = 3) -> list[str]:
+    """PATCH: a person approves picks, best first, until top_n are approved. Code can't spot a record that lies."""
+    titles = {s["id"]: s["title"] for s in world.cfp}
+    ui.step("HUMAN REVIEW: nothing reaches the committee without a person's yes")
+    if not sys.stdin.isatty():
+        ui.info("    (non-interactive run: no human here, so nothing is approved)")
+        return []
+    approved: list[str] = []
+    for sid in ranked:
+        if len(approved) == top_n:
+            break
+        if input(f"    approve {sid} '{titles[sid]}'? [y/N] ").strip().lower() == "y":
+            approved.append(sid)
+    return approved
+
