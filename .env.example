# Any OpenAI-compatible endpoint. Default: NVIDIA API (free key at https://build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
# Which models YOUR key can use (the provider's list shows more): python labs/check_models.py
# Tested setup (2026-10-29): a small privileged model and a big quarantined one.
#   Secret keeper: the small chatbot falls for levels 1-4, the big guard holds level 5 most of the time.
#   Blocks 4-5 (Dual LLM, CaMeL) swap them per run: a big planner and a small reader (see each TUTORIAL.md).
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
QLLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Nemotron 3 reasons before answering by default. Off = fast demos.
# Remove this line (and raise LLM_MAX_TOKENS to ~8000) to let it think.
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# LLM_MAX_TOKENS=1500

# --- Alternatives (comment out the NVIDIA lines above) ---
# OpenRouter, free models (50 requests/day per key): https://openrouter.ai/keys
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=liquid/lfm-2.5-2.6b:free                  # tiny, easy to talk round
#   LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free    # big, harder to fool
#   (list: curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"')
# Local, offline, free (https://ollama.com, then: ollama pull llama3.2:3b):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2:3b
# Remove LLM_EXTRA_BODY for both: it is only for Nemotron on NVIDIA.

# Optional: run the QUARANTINED LLM somewhere else, e.g. locally (CaMeL's privacy point)
# QLLM_EXTRA_BODY={}                          # extra fields for the Q-LLM's provider
# QLLM_BASE_URL=http://localhost:11434/v1     # e.g. Ollama
# QLLM_API_KEY=ollama

# Force the offline mock model (also used automatically when LLM_API_KEY is empty)
# MOCK_LLM=1
# Print full prompts and replies
# VERBOSE=1
